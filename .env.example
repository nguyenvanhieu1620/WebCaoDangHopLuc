# Copy file này thành ".env" rồi điền giá trị thật (KHÔNG commit file .env lên git).

# SQLite cho môi trường phát triển — file dev.db nằm trong thư mục drizzle/.
# Khi lên production với AWS, đổi thành connection string PostgreSQL (Aurora), ví dụ:
# DATABASE_URL="postgresql://user:password@your-aurora-endpoint:5432/hopluc"
DATABASE_URL="file:./drizzle/dev.db"

# Khoá bí mật để ký session đăng nhập admin — đổi thành chuỗi ngẫu nhiên dài khi deploy thật.
SESSION_SECRET="doi-chuoi-nay-thanh-ngau-nhien-that-dai-khi-deploy"

# Domain thật của website khi deploy — dùng để sinh sitemap.xml, robots.txt,
# và thẻ Open Graph (ảnh/link khi chia sẻ lên Facebook/Zalo). Để trống thì
# tự dùng "http://localhost:3000", KHÔNG đúng khi lên production — nhớ điền
# domain thật (VD "https://hopluc.edu.vn") trước khi public.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# API key DeepL — dùng cho nút "Dịch tự động sang tiếng Anh" trong admin (mọi
# form có khối 🇬🇧). Đăng ký miễn phí tại https://www.deepl.com/pro-api
# (gói Free: 500.000 ký tự/tháng, không cần thẻ tín dụng) — key lấy trong
# trang tài khoản DeepL thường có đuôi ":fx", code tự nhận diện đuôi này để
# gọi đúng endpoint free (api-free.deepl.com) thay vì endpoint trả phí.
# Để trống thì nút "Dịch tự động" báo lỗi rõ ràng — vẫn tự nhập tay bình thường được.
DEEPL_API_KEY=""
