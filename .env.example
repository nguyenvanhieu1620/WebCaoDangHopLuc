# Copy file này thành ".env" rồi điền giá trị thật (KHÔNG commit file .env lên git).

# PostgreSQL — dev: Postgres trong Docker (`docker compose up -d`, xem docker-compose.yml).
# Production (VPS): postgres://<user>:<mật-khẩu-mạnh>@localhost:5432/<tên-db>
# (xem CLAUDE.md mục 9 "Postgres trên VPS"). Dịch vụ cloud (Neon/Supabase) thêm "?sslmode=require".
DATABASE_URL="postgres://hopluc:hopluc_dev@localhost:5432/hopluc"

# File SQLite cũ (trước 06/10/2026) — chỉ dùng cho `npm run db:import-sqlite` chép dữ liệu sang Postgres.
SQLITE_URL="file:./drizzle/dev.db"

# Chỉ bật khi website nằm sau proxy tin cậy và origin không nhận truy cập trực tiếp.
# Số hop từ phải của X-Forwarded-For; proxy phải append IP thật hoặc ghi đè header.
# 0: không tin header, dùng giới hạn chung; 1: một proxy tin cậy.
# ⚠️ VPS chạy sau Nginx: BẮT BUỘC đặt "1" (Nginx: proxy_set_header X-Forwarded-For
# $proxy_add_x_forwarded_for; cổng Node chỉ mở cho 127.0.0.1). Để "0" thì mọi khách dùng
# chung 1 bộ đếm → cả web chỉ nhận 5 hồ sơ tuyển sinh / 10 phút. Web in cảnh báo lúc khởi động.
TRUST_PROXY_HOPS="0"

# (Tuỳ chọn) Câu truy vấn chạy quá số mili-giây này thì Postgres tự huỷ — mặc định 30000.
# DATABASE_STATEMENT_TIMEOUT_MS="30000"

# KHÔNG lưu vào .env — chỉ đặt tạm khi lỡ cần chạy `npm run db:seed -- --allow-production` trên
# máy thật (tạo admin đầu tiên với mật khẩu này thay vì mật khẩu mẫu; tối thiểu 12 ký tự).
# SEED_ADMIN_PASSWORD=""

# Khoá bí mật để ký session đăng nhập admin — đổi thành chuỗi ngẫu nhiên dài khi deploy thật.
SESSION_SECRET="doi-chuoi-nay-thanh-ngau-nhien-that-dai-khi-deploy"

# Domain thật của website khi deploy — dùng để sinh sitemap.xml, robots.txt,
# và thẻ Open Graph (ảnh/link khi chia sẻ lên Facebook/Zalo). Để trống thì
# tự dùng "http://localhost:3000", KHÔNG đúng khi lên production — nhớ điền
# domain thật (VD "https://hopluc.edu.vn") trước khi public.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# API key DeepL — dùng cho nút "Dịch tự động sang tiếng Anh" trong admin (mọi
# form có khối 🇬🇧). Đăng ký miễn phí tại https://www.deepl.com/pro-api
# (gói Free: 500.000 ký tự/tháng, không cần thẻ tín dụng) — key lấy trong
# trang tài khoản DeepL thường có đuôi ":fx", code tự nhận diện đuôi này để
# gọi đúng endpoint free (api-free.deepl.com) thay vì endpoint trả phí.
# Để trống thì nút "Dịch tự động" báo lỗi rõ ràng — vẫn tự nhập tay bình thường được.
DEEPL_API_KEY=""

# API key Resend — dùng để gửi email: báo khi có hồ sơ tuyển sinh/tin nhắn
# liên hệ mới, và link "Quên mật khẩu" cho admin. Đăng ký miễn phí tại
# https://resend.com (gói Free: 3.000 email/tháng, không cần thẻ tín dụng).
# Để trống thì các email trên tự động im lặng bỏ qua — không chặn luồng
# chính (đăng ký/liên hệ/đặt lại mật khẩu vẫn hoạt động, chỉ là không gửi
# email được).
RESEND_API_KEY=""

# Địa chỉ gửi đi — mặc định "onboarding@resend.dev" (Resend cấp sẵn, gửi
# được ngay không cần xác minh domain, nhưng chỉ nên dùng để test). Khi có
# domain thật, xác minh domain trên Resend rồi đổi thành VD
# "khong-tra-loi@hopluc.edu.vn" để email trông chuyên nghiệp hơn.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Mã đo lường Google Analytics (dạng "G-XXXXXXXXXX") — lấy trong tài khoản
# Google Analytics của bạn (xem hướng dẫn tạo tài khoản trong CLAUDE.md mục 9).
# Để trống thì site không gắn Google Analytics, không có gì bị lỗi.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Cloudflare Turnstile — xác minh "không phải bot" trên form tuyển sinh,
# liên hệ, đăng ký nhận tin (lớp chống spam mạnh hơn honeypot). Đăng ký
# miễn phí tại https://dash.cloudflare.com/?to=/:account/turnstile (xem
# hướng dẫn tạo trong CLAUDE.md mục 9). Để trống thì các form vẫn gửi bình
# thường, chỉ là chưa bật lớp chống bot nâng cao này.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
